{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/artificial-org/schemas/fact-check.schema.json",
  "title": "Fact Check",
  "type": "object",
  "additionalProperties": false,
  "required": ["verdict", "claims", "summary"],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": ["pass", "fail", "contaminated"]
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "evidence", "notes"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": ["supported", "weak", "unsupported"]
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1
    }
  }
}
